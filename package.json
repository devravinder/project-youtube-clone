{
  "name": "project-youtube-clone",
  "private": true,
  "version": "0.0.0",
  "description": "Learning-oriented mini YouTube clone — system design via open-source tools",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "help": "echo 'Scripts follow start|stop:env:service - env: l=local, lo=local-observability, c=all in containers; service: pods=infra containers, <app>=a service'",
    "start:l:pods": "docker compose -f infra/docker-compose-local.yaml up -d",
    "start:l:upload": "pnpm --filter @yt/upload-service dev",
    "start:l:web": "pnpm --filter @yt/web dev",
    "start:l:transcoder": "pnpm --filter @yt/transcoder-service dev",
    "start:l:search": "pnpm --filter @yt/search-service dev",
    "start:l:notify": "pnpm --filter @yt/notification-service dev",
    "start:lo:upload": "pnpm --filter @yt/upload-service dev:lo",
    "start:lo:transcoder": "pnpm --filter @yt/transcoder-service dev:lo",
    "start:lo:search": "pnpm --filter @yt/search-service dev:lo",
    "start:lo:notify": "pnpm --filter @yt/notification-service dev:lo",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "db:generate": "pnpm -r --if-present db:generate",
    "db:migrate": "pnpm -r --if-present db:migrate",
    "db:reset": "pnpm -r --if-present db:reset",
    "api:generate": "pnpm --filter @yt/upload-service --filter @yt/search-service openapi:generate && pnpm --filter @yt/contracts asyncapi:generate && pnpm --filter @yt/web api:types",
    "api:check": "pnpm api:generate && git diff --exit-code contracts apps/web/src/api",
    "stop:l:pods": "docker compose -f infra/docker-compose-local.yaml down -v",
    "images:build": "node scripts/build-images.mjs",
    "start:c:all": "docker compose -f infra/docker-compose-local-apps.yaml up -d",
    "stop:c:all": "docker compose -f infra/docker-compose-local-apps.yaml down -v",
    "logs:c": "docker compose -f infra/docker-compose-local-apps.yaml logs -f",
    "k8s:check": "node scripts/check-helm.mjs",
    "load:check": "pnpm --filter @yt/load-tests typecheck",
    "logs:l": "docker compose -f infra/docker-compose-local.yaml logs -f",
    "start:lo:pods": "docker compose -f infra/docker-compose-local-observability.yaml up -d",
    "stop:lo:pods": "docker compose -f infra/docker-compose-local-observability.yaml down -v",
    "logs:lo": "docker compose -f infra/docker-compose-local-observability.yaml logs -f",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#**/node_modules\"",
    "format:md": "markdownlint-cli2 --fix \"**/*.md\" \"#**/node_modules\"",
    "format:java": "pnpm -r --if-present format",
    "format:java:check": "pnpm -r --if-present format:check"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.0",
    "markdownlint-cli2": "^0.15.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.3",
    "yaml": "2.9.1"
  }
}
