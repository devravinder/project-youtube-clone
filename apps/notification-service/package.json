{
  "name": "@yt/notification-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.sample --import @yt/telemetry/register src/main.ts",
    "dev:lo": "tsx watch --env-file=.env.sample --env-file=.env.observability --import @yt/telemetry/register src/main.ts",
    "start": "tsx --env-file=.env.sample --import @yt/telemetry/register src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/platform-ws": "12.2.0",
    "@nestjs/websockets": "12.2.0",
    "@opentelemetry/api": "1.10.0",
    "@platformatic/kafka": "2.14.0",
    "@yt/config": "workspace:*",
    "@yt/contracts": "workspace:*",
    "@yt/telemetry": "workspace:*",
    "jose": "6.2.13",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
