{
  "name": "@yt/upload-service",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.sample src/main.ts",
    "start": "tsx --env-file=.env.sample src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi:generate": "tsx --env-file=.env.sample src/openapi/generate.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "node ../../scripts/assert-local-db.mjs && prisma migrate reset --force"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/schedule": "12.0.2",
    "@nestjs/swagger": "12.0.4",
    "@platformatic/kafka": "2.14.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.1",
    "@yt/config": "workspace:*",
    "@yt/contracts": "workspace:*",
    "@yt/ports": "workspace:*",
    "amqplib": "2.2.0",
    "jose": "6.2.13",
    "redis": "6.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@types/node": "26.6.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
