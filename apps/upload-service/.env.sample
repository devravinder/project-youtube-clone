NODE_ENV=development
APP_ENV=local
PORT=3001
LOG_LEVEL=info
DATABASE_URL=postgresql://yt:yt_password@localhost:5432/youtube_clone
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
UPLOAD_PENDING_TTL_MINUTES=1440
OIDC_ISSUER_URL=http://localhost:8180/realms/youtube-clone
OIDC_AUDIENCE=yt-api
UPLOAD_PART_SIZE_MB=8
RABBITMQ_URL=amqp://yt:yt_password@localhost:5672
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_RETENTION_HOURS=72
HLS_PUBLIC_BASE_URL=http://localhost:8088/hls-videos
KAFKA_BROKERS=localhost:9094
KAFKA_VIDEO_EVENTS_TOPIC=yt.video-events
REDIS_URL=redis://localhost:6379
VIDEO_CACHE_TTL_SECONDS=60
VIEW_FLUSH_INTERVAL_MS=10000
VIEW_DEDUPE_MINUTES=30
