# Internal package registry (jFrog). Fill in your org's values.
# Scoped packages (@yt/*) are local workspace packages and resolve via pnpm workspaces.
#
# Default registry — replace <JFROG_HOST> and the repo path with your org's npm registry:
# registry=https://<JFROG_HOST>/artifactory/api/npm/<NPM_REPO>/
#
# If internal packages use a dedicated scope, pin that scope to the registry:
# @<org-scope>:registry=https://<JFROG_HOST>/artifactory/api/npm/<NPM_REPO>/
#
# Auth is provided per-developer and MUST NOT be committed. Configure it in your user-level
# ~/.npmrc (not this file), e.g.:
# //<JFROG_HOST>/artifactory/api/npm/<NPM_REPO>/:_authToken=${NPM_TOKEN}

# pnpm settings
auto-install-peers=true
strict-peer-dependencies=false
