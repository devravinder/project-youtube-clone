# @import ./keycloak.http

@baseUrl = http://localhost:3001

### Create a presigned upload URL
# @name presign
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4",
  "title": "My first video",
  "description": "Uploaded from httpYac"
}

?? status == 201
?? js response.parsedBody.videoId isString
?? js response.parsedBody.key endsWith source.mp4
?? js response.parsedBody.expiresInSeconds == 900

### Upload a real file straight to storage using the presigned URL
# @name upload
# @forceRef presign
PUT {{presign.uploadUrl}}
Content-Type: video/mp4

< {{VIDEO_FILE}}

?? status == 200

### Title defaults to the filename when omitted
# @name noUpload
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "Holiday Trip.MOV",
  "contentType": "video/quicktime"
}

?? status == 201
?? js response.parsedBody.key endsWith source.mov

### Untrusted filename path never reaches the storage key
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "../../etc/passwd.mp4",
  "contentType": "video/mp4"
}

?? status == 201
?? js response.parsedBody.key matches ^[0-9a-f-]{36}/source\.mp4$

### Unsafe extension is dropped from the storage key
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "movie.mp4;rm -rf",
  "contentType": "video/mp4"
}

?? status == 201
?? js response.parsedBody.key matches ^[0-9a-f-]{36}/source$

### Presign without a token is rejected
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4"
}

?? status == 401

### Presign with a garbage token is rejected
POST {{baseUrl}}/uploads/presign
Authorization: Bearer not.a.token
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4"
}

?? status == 401

### Another user cannot confirm someone else's upload
# @ref noUpload
# @ref bobToken
POST {{baseUrl}}/uploads/{{noUpload.videoId}}/complete
Authorization: Bearer {{bobToken.access_token}}

?? status == 403

### Confirm without a token is rejected
# @ref noUpload
POST {{baseUrl}}/uploads/{{noUpload.videoId}}/complete

?? status == 401
### Reject a non-video content type
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "notes.txt",
  "contentType": "text/plain"
}

?? status == 400

### Reject a missing filename
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "contentType": "video/mp4"
}

?? status == 400

### Reject a missing content type
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4"
}

?? status == 400

### Reject a title longer than 200 characters
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4",
  "title": "{{'x'.repeat(201)}}"
}

?? status == 400

### Seed video A for the pagination tests
# @name seedA
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "seedA.mp4",
  "contentType": "video/mp4"
}

?? status == 201

###
# @name seedAPut
# @ref seedA
PUT {{seedA.uploadUrl}}
Content-Type: video/mp4

< {{VIDEO_FILE}}

?? status == 200

###
# @ref seedAPut
# @ref token
POST {{baseUrl}}/uploads/{{seedA.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 201
### Seed video B for the pagination tests
# @name seedB
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "seedB.mp4",
  "contentType": "video/mp4"
}

?? status == 201

###
# @name seedBPut
# @ref seedB
PUT {{seedB.uploadUrl}}
Content-Type: video/mp4

< {{VIDEO_FILE}}

?? status == 200

###
# @ref seedBPut
# @ref token
POST {{baseUrl}}/uploads/{{seedB.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 201
### First page of videos, newest first
# @name page1
GET {{baseUrl}}/videos?limit=2

?? status == 200
?? js response.parsedBody.items isArray
?? js response.parsedBody.items.length == 2
?? js response.parsedBody.nextCursor isString

### Second page continues after the first
# @ref page1
GET {{baseUrl}}/videos?limit=2&cursor={{page1.nextCursor}}

?? status == 200
?? js response.parsedBody.items.length == 2
?? js response.parsedBody.items[0].id == {{page1.nextCursor}}

### Default page size is 12
GET {{baseUrl}}/videos

?? status == 200
?? js response.parsedBody.items.length <= 12

### Reject a limit of zero
GET {{baseUrl}}/videos?limit=0

?? status == 400

### Reject a limit above 50
GET {{baseUrl}}/videos?limit=51

?? status == 400

### Reject a malformed cursor
GET {{baseUrl}}/videos?cursor=not-a-uuid

?? status == 400

### Confirming before the file exists is rejected
# @name earlyConfirm
# @ref noUpload
# @ref token
POST {{baseUrl}}/uploads/{{noUpload.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 409

### Pending video is hidden from the list
# @ref noUpload
GET {{baseUrl}}/videos?limit=50

?? status == 200
?? js !response.parsedBody.items.map(v => v.id).includes(noUpload.videoId)

### Confirm marks the video as uploaded
# @name confirm
# @ref upload
# @ref token
POST {{baseUrl}}/uploads/{{presign.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 201
?? js response.parsedBody.status == UPLOADED

### Confirming twice is harmless
# @ref presign
# @ref token
POST {{baseUrl}}/uploads/{{presign.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 201
?? js response.parsedBody.status == UPLOADED

### Confirm unknown video returns 404
# @ref token
POST {{baseUrl}}/uploads/00000000-0000-4000-8000-000000000000/complete
Authorization: Bearer {{token.access_token}}

?? status == 404

### Confirm malformed id returns 400
# @ref token
POST {{baseUrl}}/uploads/not-a-uuid/complete
Authorization: Bearer {{token.access_token}}

?? status == 400

### Uploaded video has a playback URL
# @name detail
# @ref confirm
GET {{baseUrl}}/videos/{{presign.videoId}}

?? status == 200
?? js response.parsedBody.title == My first video
?? js response.parsedBody.status == UPLOADED
?? js response.parsedBody.viewCount == 0
?? js response.parsedBody.playbackUrl isString

### Playback URL supports range requests (needed for seeking)
# @ref detail
GET {{detail.playbackUrl}}
Range: bytes=0-99

?? status == 206
?? header content-range startsWith bytes 0-99/
?? header accept-ranges == bytes

### Video without an uploaded file has no playback URL
# @ref noUpload
GET {{baseUrl}}/videos/{{noUpload.videoId}}

?? status == 200
?? body contains "playbackUrl":null

### Unknown video returns 404
GET {{baseUrl}}/videos/00000000-0000-4000-8000-000000000000

?? status == 404

### Malformed id returns 400
GET {{baseUrl}}/videos/not-a-uuid

?? status == 400
