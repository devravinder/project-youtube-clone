# @import ./keycloak.http

@baseUrl = http://localhost:3001

### Create a presigned upload URL
# @name presign
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4",
  "title": "My first video",
  "description": "Uploaded from httpYac"
}

?? status == 201
?? js response.parsedBody.videoId isString
?? js response.parsedBody.key endsWith source.mp4
?? js response.parsedBody.expiresInSeconds == 900

### Upload a real file straight to storage using the presigned URL
# @name upload
# @forceRef presign
PUT {{presign.uploadUrl}}
Content-Type: video/mp4

< {{VIDEO_FILE}}

?? status == 200

### Title defaults to the filename when omitted
# @name noUpload
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "Holiday Trip.MOV",
  "contentType": "video/quicktime"
}

?? status == 201
?? js response.parsedBody.key endsWith source.mov

### Untrusted filename path never reaches the storage key
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "../../etc/passwd.mp4",
  "contentType": "video/mp4"
}

?? status == 201
?? js response.parsedBody.key matches ^[0-9a-f-]{36}/source\.mp4$

### Unsafe extension is dropped from the storage key
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "movie.mp4;rm -rf",
  "contentType": "video/mp4"
}

?? status == 201
?? js response.parsedBody.key matches ^[0-9a-f-]{36}/source$

### Presign without a token is rejected
POST {{baseUrl}}/uploads/presign
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4"
}

?? status == 401

### Presign with a garbage token is rejected
POST {{baseUrl}}/uploads/presign
Authorization: Bearer not.a.token
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4"
}

?? status == 401

### Another user cannot confirm someone else's upload
# @ref noUpload
# @ref bobToken
POST {{baseUrl}}/uploads/{{noUpload.videoId}}/complete
Authorization: Bearer {{bobToken.access_token}}

?? status == 403

### Confirm without a token is rejected
# @ref noUpload
POST {{baseUrl}}/uploads/{{noUpload.videoId}}/complete

?? status == 401
### Multipart: create a 1 MB file to use as the single part
{{
  const fs = require("node:fs");
  const os = require("node:os");
  const path = require("node:path");
  exports.partFile = path.join(os.tmpdir(), "yt-part-1mb.bin");
  fs.writeFileSync(exports.partFile, Buffer.alloc(1_000_000, 1));
}}

### Multipart: start an upload and get the part plan
# @name mpInit
# @ref token
POST {{baseUrl}}/uploads/multipart
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "big.mp4",
  "contentType": "video/mp4",
  "fileSize": 1000000,
  "title": "Multipart video"
}

?? status == 201
?? js response.parsedBody.partSize == 8388608
?? js response.parsedBody.partCount == 1
### Multipart: a 20 MB file needs 3 parts
# @name mpPlan
# @ref token
POST {{baseUrl}}/uploads/multipart
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "big.mp4",
  "contentType": "video/mp4",
  "fileSize": 20000000
}

?? status == 201
?? js response.parsedBody.partCount == 3

### Multipart: abort discards the unfinished upload
# @ref mpPlan
# @ref token
DELETE {{baseUrl}}/uploads/{{mpPlan.videoId}}
Authorization: Bearer {{token.access_token}}

?? status == 204

### Multipart: an aborted upload is gone
# @ref mpPlan
GET {{baseUrl}}/videos/{{mpPlan.videoId}}

?? status == 404

### Multipart: reject a zero file size
# @ref token
POST {{baseUrl}}/uploads/multipart
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "big.mp4",
  "contentType": "video/mp4",
  "fileSize": 0
}

?? status == 400

### Multipart: start requires a token
POST {{baseUrl}}/uploads/multipart
Content-Type: application/json

{
  "filename": "big.mp4",
  "contentType": "video/mp4",
  "fileSize": 5000000
}

?? status == 401

### Multipart: nothing stored yet
# @ref mpInit
# @ref token
GET {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{token.access_token}}

?? status == 200
?? js response.parsedBody.partCount == 1
?? js response.parsedBody.uploadedParts.length == 0

### Multipart: completing without the parts is rejected
# @ref mpInit
# @ref token
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 409

### Multipart: get the URL for part 1
# @name mpUrls
# @ref mpInit
# @ref token
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "partNumbers": [1]
}

?? status == 201
?? js response.parsedBody.urls.length == 1
?? js response.parsedBody.urls[0].partNumber == 1

### Multipart: a part number beyond the plan is rejected
# @ref mpInit
# @ref token
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "partNumbers": [2]
}

?? status == 400

### Multipart: another user cannot get part URLs
# @ref mpInit
# @ref bobToken
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{bobToken.access_token}}
Content-Type: application/json

{
  "partNumbers": [1]
}

?? status == 403

### Multipart: PUT the bytes of part 1 straight to storage
# @name mpPut
# @ref mpUrls
PUT {{mpUrls.urls[0].url}}

< {{partFile}}

?? status == 200

### Multipart: the stored part is listed (for resuming)
# @ref mpPut
# @ref mpInit
# @ref token
GET {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{token.access_token}}

?? status == 200
?? js response.parsedBody.uploadedParts.length == 1
?? js response.parsedBody.uploadedParts[0].partNumber == 1

### Multipart: complete joins the parts and marks the video uploaded
# @name mpComplete
# @ref mpPut
# @ref token
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 201
?? js response.parsedBody.status == UPLOADED

### Multipart: the finished video is playable
# @ref mpComplete
GET {{baseUrl}}/videos/{{mpInit.videoId}}

?? status == 200
?? js response.parsedBody.title == Multipart video
?? js response.parsedBody.playbackUrl isString

### Multipart: declared size that the uploaded part does not match
# @name mpBad
# @ref token
POST {{baseUrl}}/uploads/multipart
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "liar.mp4",
  "contentType": "video/mp4",
  "fileSize": 2000000
}

?? status == 201
?? js response.parsedBody.partCount == 1

### Multipart: get the URL for the mismatched part
# @name mpBadUrls
# @ref mpBad
# @ref token
POST {{baseUrl}}/uploads/{{mpBad.videoId}}/parts
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "partNumbers": [1]
}

?? status == 201

### Multipart: upload only 1 MB although 2 MB was declared
# @name mpBadPut
# @ref mpBadUrls
PUT {{mpBadUrls.urls[0].url}}

< {{partFile}}

?? status == 200

### Multipart: complete is refused because the sizes differ
# @ref mpBadPut
# @ref token
POST {{baseUrl}}/uploads/{{mpBad.videoId}}/complete
Authorization: Bearer {{token.access_token}}

?? status == 409
?? js response.parsedBody.message == Part 1 has 1000000 bytes, expected 2000000

### Multipart: clean up the mismatched upload
# @ref mpBad
# @ref token
DELETE {{baseUrl}}/uploads/{{mpBad.videoId}}
Authorization: Bearer {{token.access_token}}

?? status == 204
### Multipart: part URLs are refused once the upload is finished
# @ref mpComplete
# @ref token
POST {{baseUrl}}/uploads/{{mpInit.videoId}}/parts
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "partNumbers": [1]
}

?? status == 409
### Reject a non-video content type
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "notes.txt",
  "contentType": "text/plain"
}

?? status == 400

### Reject a missing filename
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "contentType": "video/mp4"
}

?? status == 400

### Reject a missing content type
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4"
}

?? status == 400

### Reject a title longer than 200 characters
# @ref token
POST {{baseUrl}}/uploads/presign
Authorization: Bearer {{token.access_token}}
Content-Type: application/json

{
  "filename": "clip.mp4",
  "contentType": "video/mp4",
  "title": "{{'x'.repeat(201)}}"
}

?? status == 400

